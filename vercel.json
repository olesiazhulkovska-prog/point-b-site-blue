{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/keycrm",
      "destination": "/?utm_source=keycrm_support&utm_medium=chat&utm_campaign=profile",
      "permanent": false
    },
    {
      "source": "/keycrm/",
      "destination": "/?utm_source=keycrm_support&utm_medium=chat&utm_campaign=profile",
      "permanent": false
    }
  ]
}
